# Local Docker Compose only. Choose a separate secret for a deployed database.
DB_PASSWORD=etiket_local_only

# Keep a separate reviewer password in your untracked .env or Railway Variables.
# Blank disables submissions/review while normal product lookup remains available.
REVIEW_ADMIN_USERNAME=reviewer
REVIEW_ADMIN_PASSWORD=

# Optional backend OCR diagnostics. Keep this false after the investigation.
OCR_DIAGNOSTICS=false

# Optional for the hosted backend. Set a real project or contact URL before enabling.
OFF_ENABLED=false
OFF_USER_AGENT="Etiket/0.6.4 (https://github.com/al1-hasanov/etiket-scan)"
